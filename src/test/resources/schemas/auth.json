{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthResponse",
  "type": "object",
  "required": ["token", "email", "role"],
  "additionalProperties": false,
  "properties": {
    "token": { "type": "string", "pattern": "^[\\w-]+\\.[\\w-]+\\.[\\w-]+$" },
    "email": { "type": "string", "minLength": 3 },
    "role": { "type": "string", "enum": ["USER", "ADMIN"] }
  }
}

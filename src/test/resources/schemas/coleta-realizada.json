{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ColetaRealizadaResponse",
  "type": "object",
  "required": ["idColeta", "idPonto", "enderecoPonto", "dataColeta", "pesoRecolhidoKg", "empresaResponsavel"],
  "additionalProperties": false,
  "properties": {
    "idColeta": { "type": "integer", "minimum": 1 },
    "idPonto": { "type": "integer", "minimum": 1 },
    "enderecoPonto": { "type": "string", "minLength": 1 },
    "dataColeta": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pesoRecolhidoKg": { "type": "number", "exclusiveMinimum": 0 },
    "empresaResponsavel": { "type": "string", "minLength": 1, "maxLength": 50 }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PontoColetaResponse",
  "type": "object",
  "required": ["idPonto", "endereco", "tipo", "capacidadeMaxKg", "volumeAtualKg"],
  "additionalProperties": false,
  "properties": {
    "idPonto": { "type": "integer", "minimum": 1 },
    "endereco": { "type": "string", "minLength": 1, "maxLength": 100 },
    "tipo": {
      "type": "object",
      "required": ["idTipo", "descricao", "reciclavel", "perigoso"],
      "additionalProperties": false,
      "properties": {
        "idTipo": { "type": "integer", "minimum": 1 },
        "descricao": { "type": "string", "minLength": 1 },
        "reciclavel": { "type": "string", "enum": ["S", "N"] },
        "perigoso": { "type": "string", "enum": ["S", "N"] }
      }
    },
    "capacidadeMaxKg": { "type": "number", "exclusiveMinimum": 0 },
    "volumeAtualKg": { "type": "number", "minimum": 0 }
  }
}

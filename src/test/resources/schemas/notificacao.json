{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotificacaoResponse",
  "type": "object",
  "required": ["idNotificacao", "nomeUsuario", "enderecoPonto", "mensagem", "dataEnvio", "lida"],
  "additionalProperties": false,
  "properties": {
    "idNotificacao": { "type": "integer", "minimum": 1 },
    "nomeUsuario": { "type": "string", "minLength": 1 },
    "enderecoPonto": { "type": "string", "minLength": 1 },
    "mensagem": { "type": "string", "minLength": 1, "maxLength": 300 },
    "dataEnvio": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "lida": { "type": "string", "enum": ["S", "N"] }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlertaCapacidadeResponse",
  "type": "object",
  "required": ["idAlerta", "idPonto", "enderecoPonto", "dataGeracao", "mensagem", "statusResolvido"],
  "additionalProperties": false,
  "properties": {
    "idAlerta": { "type": "integer", "minimum": 1 },
    "idPonto": { "type": "integer", "minimum": 1 },
    "enderecoPonto": { "type": "string", "minLength": 1 },
    "dataGeracao": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mensagem": { "type": "string", "minLength": 1, "maxLength": 200 },
    "statusResolvido": { "type": "string", "enum": ["S", "N"] }
  }
}

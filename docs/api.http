### e cole abaixo substituindo o valor de @token
@token = eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbkBlc2cuY29tIiwicm9sZSI6IkFETUlOIiwiaWF0IjoxNzc3MTUyMDc3LCJleHAiOjE3NzcyMzg0Nzd9.BdhBB2SDHqP5bzglpq1w0gVKEg-u2pc3vWDeE5LcqVE

